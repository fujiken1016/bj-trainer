# Cloudflare Pages 用セキュリティ / キャッシュヘッダ
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/legal.css
  Cache-Control: public, max-age=86400

# リポジトリ直下＝Cloudflare Pages の公開ディレクトリなので、運用ドキュメント(.md)も
# URLとして生きてしまう。消すと履歴が失われるため、検索インデックスからだけ外す。
# （robots.txt の Disallow は使わない。クロールを止めると noindex を読んでもらえないため）
/*.md
  X-Robots-Tag: noindex
/README.md
  X-Robots-Tag: noindex
/AFF_SLOTS.md
  X-Robots-Tag: noindex
/vercel.json
  X-Robots-Tag: noindex
